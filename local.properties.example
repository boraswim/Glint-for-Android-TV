# Copy to local.properties (git-ignored) and fill in.

# Android SDK location (Android Studio writes this for you).
sdk.dir=C\:\Users\<you>\AppData\Local\Android\Sdk

# Optional: your own release signing key. Without it, release builds are signed with the debug key.
# release.storeFile=C:/path/to/glint-release.jks
# release.storePassword=
# release.keyAlias=glint
# release.keyPassword=
